# Maintainer: Andre Bruno
pkgname=omarchy-always-on-top
pkgver=0.1.0
pkgrel=1
pkgdesc="Always On Top for Omarchy — keep a window above the others, with a highlight border in the theme's accent colour (PowerToys Always On Top, ported)"
arch=('any')
url="https://github.com/andrebbruno/omarchy-always-on-top"
license=('MIT')
depends=('python' 'hyprland')
optdepends=('gum: menu fallback outside Omarchy'
            'libnotify: the notification when a window is pinned')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('8038e69138c4ddb1899532f1b7600e3f1a46e37a18c0ff44713e988f3e59341d')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH="$PWD" python -m pytest tests -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
